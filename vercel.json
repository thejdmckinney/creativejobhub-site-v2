{
  "buildCommand": "npm run build:simple",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "crewopspro.com"
        }
      ],
      "destination": "https://www.crewopspro.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.crewopspro.com"
        },
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://www.crewopspro.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "creativejobhub.com"
        }
      ],
      "destination": "https://www.creativejobhub.com/:path*",
      "permanent": true
    },
    {
      "source": "/hvac-field-service-software/:path*",
      "destination": "/hvac-software",
      "permanent": true
    },
    {
      "source": "/industries/pool-service/:path*",
      "destination": "/pool-service-software",
      "permanent": true
    },
    {
      "source": "/features/boost-reviews/:path*",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/industries/pest-control/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/electrical-field-service-software/:path*",
      "destination": "/electrical-software",
      "permanent": true
    },
    {
      "source": "/chimney-service-field-service-software/:path*",
      "destination": "/chimney-sweep-software",
      "permanent": true
    },
    {
      "source": "/pressure-washing-field-service-software/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/features/simplified-communications/:path*",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/industries/pressure-washing/:path*",
      "destination": "/painting-software",
      "permanent": true
    },
    {
      "source": "/assets/header.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/why-i-built-this",
      "permanent": true
    },
    {
      "source": "/appliance-repair-field-service-software/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/carpet-cleaning-field-service-software/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)[.](jpg|jpeg|png|gif|svg|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)[.](js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
