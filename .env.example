# Resend API Key for sending emails (contact form, newsletter)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Slack Webhook URL for notifications (optional)
# Get your webhook from: https://api.slack.com/apps
# Used for: contact form submissions, newsletter signups, newsletter confirmations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Supabase Configuration for comments and newsletter subscribers
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Newsletter Admin Key (for sending newsletters via /api/newsletter/send)
# Set this to a secure random string - this protects the newsletter send endpoint
NEWSLETTER_ADMIN_KEY=your_secure_random_string_here
