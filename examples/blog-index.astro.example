---
// Example: Blog listing page
import MainLayout from '../../layouts/MainLayout.astro';
import { sanityClient } from '../../lib/client';
import type { SanityDocument } from '@sanity/client';

interface BlogPost extends SanityDocument {
  title: string;
  slug: { current: string };
  excerpt: string;
  publishedAt: string;
  mainImageUrl: string;
  author: {
    name: string;
  };
}

// Fetch all blog posts at BUILD time
const posts: BlogPost[] = await sanityClient.fetch(`
  *[_type == "blogPost"] | order(publishedAt desc) {
    _id,
    title,
    slug,
    excerpt,
    publishedAt,
    "mainImageUrl": mainImage.asset->url,
    author->{
      name
    }
  }
`);

const title = "Blog | Creative Job Hub";
const description = "Tips, guides, and insights for field service businesses to streamline operations and grow.";
---

<MainLayout title={title} description={description}>
  <div class="bg-white">
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h1 class="text-5xl font-bold text-gray-900 mb-4">
            Field Service Blog
          </h1>
          <p class="text-xl text-gray-600">
            Tips, guides, and insights to help you run your service business better
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {posts.map((post) => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow">
              {post.mainImageUrl && (
                <a href={`/blog/${post.slug.current}`}>
                  <img 
                    src={post.mainImageUrl} 
                    alt={post.title}
                    class="w-full h-48 object-cover"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="p-6">
                <time class="text-sm text-gray-500 block mb-2">
                  {new Date(post.publishedAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                <h2 class="text-2xl font-bold text-gray-900 mb-3 hover:text-blue-600">
                  <a href={`/blog/${post.slug.current}`}>
                    {post.title}
                  </a>
                </h2>
                <p class="text-gray-600 mb-4 line-clamp-3">
                  {post.excerpt}
                </p>
                {post.author && (
                  <p class="text-sm text-gray-500">
                    By {post.author.name}
                  </p>
                )}
                <a 
                  href={`/blog/${post.slug.current}`}
                  class="text-blue-600 hover:text-blue-800 font-semibold inline-flex items-center mt-4"
                >
                  Read More 
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
        
        {posts.length === 0 && (
          <div class="text-center py-20">
            <p class="text-xl text-gray-600">
              No blog posts yet. Check back soon!
            </p>
          </div>
        )}
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
